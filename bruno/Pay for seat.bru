meta {
  name: Pay for seat
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/events/{{eventId}}/seats/{{seatId}}/pay
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "amountPaise": 150000,
    "paymentMethodId": "pm_card_visa"
  }
}

